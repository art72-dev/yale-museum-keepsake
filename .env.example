# Copy this file to .env and fill in real values. Never commit .env or share these values.
# The app looks for .env in this folder first, then in the folder above it.
# (The LUX data harvester needs no keys.)

# Course key: OpenAI gpt-6-luna through the Portkey gateway (writes the object descriptions)
PORTKEY_API_KEY=your-portkey-api-key-here

# Only if you use a personal OpenAI key for another model (not used by default)
OPENAI_API_KEY=your-openai-api-key-here

# Optional settings (defaults shown)
# KEEPSAKE_DATA=data/lux/samples        # test data; use data/lux/full after the full harvest
# KEEPSAKE_MODEL=gpt-6-luna             # the only model allowed on the course key
# KEEPSAKE_REASONING=low                # reasoning effort for the description writer
# KEEPSAKE_DAILY_TOKENS=500000          # AI token budget per day; after that, pages show museum captions
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# LUX_CONTACT=your-email@yale.edu       # added to the harvester's User-Agent
